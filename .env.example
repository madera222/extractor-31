# Telegram API credentials — get from https://my.telegram.org
API_ID=12345678
API_HASH=your_api_hash_here

# Bot token — get from @BotFather on Telegram
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Telegram user ID (owner)
OWNER_ID=123456789

# Space-separated extra admin user IDs (optional)
SUDO_USERS=111111 222222

# MongoDB connection string
MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority

# Your Telegram channel ID (with -100 prefix for supergroups)
CHANNEL_ID=-1001234567890

# Channel/group ID for premium logs (optional)
PREMIUM_LOGS=-1009876543210
